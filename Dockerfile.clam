# Dockerfile for Clam Static Analyzer (SeaHorn)
# Based on: https://github.com/seahorn/clam

FROM ubuntu:22.04

LABEL maintainer="SVF Tools"
LABEL description="Clam static analyzer environment (LLVM 14)"

ENV DEBIAN_FRONTEND=noninteractive

# Install base dependencies
RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
      ca-certificates \
      gnupg \
      wget \
      software-properties-common \
      git \
      cmake \
      ninja-build \
      make \
      g++ \
      gcc \
      python3 \
      python3-pip \
      libboost-all-dev \
      libboost-program-options-dev \
      libgmp-dev \
      libmpfr-dev \
      libflint-dev \
      zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

# Add LLVM apt repository for LLVM 14
RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc && \
    echo "deb http://apt.llvm.org/jammy/ llvm-toolchain-jammy-14 main" >> /etc/apt/sources.list.d/llvm.list

# Install LLVM 14 (required by Clam)
RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
      llvm-14 \
      llvm-14-dev \
      llvm-14-tools \
      clang-14 \
      libclang-14-dev && \
    rm -rf /var/lib/apt/lists/*

# Create symlinks for LLVM 14 tools
RUN update-alternatives --install /usr/bin/clang clang /usr/bin/clang-14 100 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-14 100 && \
    update-alternatives --install /usr/bin/llvm-config llvm-config /usr/bin/llvm-config-14 100 && \
    update-alternatives --install /usr/bin/opt opt /usr/bin/opt-14 100 && \
    update-alternatives --install /usr/bin/llc llc /usr/bin/llc-14 100

# Set environment variables
ENV CC=clang-14
ENV CXX=clang++-14
ENV LLVM_DIR=/usr/lib/llvm-14

# Clone and build Clam
WORKDIR /opt
RUN git clone --depth 1 --branch dev14 https://github.com/seahorn/clam.git

WORKDIR /opt/clam/build
RUN cmake -DCMAKE_INSTALL_PREFIX=/opt/clam-install \
          -DLLVM_DIR=/usr/lib/llvm-14/lib/cmake/llvm \
          -DCMAKE_BUILD_TYPE=Release \
          -G Ninja \
          ../ && \
    cmake --build . --target crab && cmake .. && \
    cmake --build . --target extra && cmake .. && \
    cmake --build . && \
    cmake --build . --target install

# Add Clam to PATH
ENV PATH="/opt/clam-install/bin:${PATH}"

# Working directory for analysis
WORKDIR /workspace

CMD ["/bin/bash"]
