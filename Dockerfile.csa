# Dockerfile for Clang Static Analyzer (CSA)
# Provides scan-build and clang-tidy for static analysis

FROM ubuntu:22.04

LABEL maintainer="SVF Tools"
LABEL description="Clang Static Analyzer (CSA) environment with LLVM 18"

ENV DEBIAN_FRONTEND=noninteractive

# Install base dependencies
RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
      ca-certificates \
      gnupg \
      wget \
      software-properties-common && \
    rm -rf /var/lib/apt/lists/*

# Add LLVM apt repository for LLVM 18
RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc && \
    echo "deb http://apt.llvm.org/jammy/ llvm-toolchain-jammy-18 main" >> /etc/apt/sources.list.d/llvm.list

# Install LLVM 18 and Clang tools
RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
      clang-18 \
      clang-tools-18 \
      clang-tidy-18 \
      llvm-18 \
      llvm-18-dev \
      llvm-18-tools \
      libclang-18-dev \
      libclang-common-18-dev \
      lld-18 \
      libc++-18-dev \
      libc++abi-18-dev \
      cmake \
      make \
      ninja-build \
      git \
      python3 \
      python3-pip \
      bear && \
    rm -rf /var/lib/apt/lists/*

# Create symlinks for LLVM 18 tools
RUN update-alternatives --install /usr/bin/clang clang /usr/bin/clang-18 100 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-18 100 && \
    update-alternatives --install /usr/bin/clang-tidy clang-tidy /usr/bin/clang-tidy-18 100 && \
    update-alternatives --install /usr/bin/scan-build scan-build /usr/bin/scan-build-18 100 && \
    update-alternatives --install /usr/bin/scan-view scan-view /usr/bin/scan-view-18 100 && \
    update-alternatives --install /usr/bin/llvm-config llvm-config /usr/bin/llvm-config-18 100 && \
    update-alternatives --install /usr/bin/opt opt /usr/bin/opt-18 100 && \
    update-alternatives --install /usr/bin/llc llc /usr/bin/llc-18 100 && \
    update-alternatives --install /usr/bin/ld.lld ld.lld /usr/bin/ld.lld-18 100

# Set environment variables
ENV CC=clang-18
ENV CXX=clang++-18
ENV LLVM_DIR=/usr/lib/llvm-18

# Working directory for analysis
WORKDIR /workspace

CMD ["/bin/bash"]
